---
import Layout from '../layouts/Layout.astro';
import { getPublicBackendApiUrl } from '../lib/backend-auth';

export const prerender = false;

if (Astro.locals.user) {
    return Astro.redirect(Astro.locals.user.mustChangePassword ? '/profile?forcePasswordChange=1' : '/dashboard');
}

const backendApiUrl = getPublicBackendApiUrl();
---

<Layout title="Вход">
    <a slot="nav-actions" href="/" class="back-schedule-link" aria-label="На главную" title="На главную">
        <img src="/image/schedule.png" alt="" class="back-schedule-icon" />
    </a>

    <section class="auth-page">
        <div class="auth-card">
            <form id="login-form" class="auth-form">
                <div id="error-message" class="auth-error hidden"></div>
                <div>
                    <h2>Вход</h2>
                </div>

                <div class="auth-field">
                    <label for="username">Логин</label>
                    <input
                            id="username"
                            name="username"
                            type="text"
                            required
                            autocomplete="username"
                            placeholder="Введите логин"
                    />
                </div>

                <div class="auth-field">
                    <label for="password">Пароль</label>

                    <div class="password-wrap">
                        <input
                                id="password"
                                name="password"
                                type="password"
                                required
                                autocomplete="current-password"
                                placeholder="Введите пароль"
                        />

                        <button id="password-toggle" type="button" aria-label="Показать пароль">
                            <svg id="eye-icon" viewBox="0 0 24 24" fill="none">
                                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="2"/>
                                <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
                            </svg>

                            <svg id="eye-off-icon" class="hidden" viewBox="0 0 24 24" fill="none">
                                <path d="M3 3l18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M10.6 10.6a2 2 0 002.8 2.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M7.1 7.5C4.2 9 2.5 12 2.5 12s3.5 6 9.5 6c1.6 0 3-.4 4.2-1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                <path d="M14 6.3c4.7.9 7.5 5.7 7.5 5.7s-.8 1.4-2.2 2.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <label class="remember-row">
                    <input id="remember" name="remember" type="checkbox" checked />
                    <span>Оставаться в системе</span>
                </label>

                <button type="submit" id="submit-btn" class="auth-submit">
                    Вход
                </button>
            </form>
        </div>
    </section>

    <script define:vars={{ backendApiUrl }}>
        const form = document.querySelector('#login-form');
        const errorDiv = document.querySelector('#error-message');
        const submitBtn = document.querySelector('#submit-btn');
        const passwordInput = document.querySelector('#password');
        const passwordToggle = document.querySelector('#password-toggle');

        const csrfToken = document
            .querySelector('meta[name="backend-csrf-token"]')
            ?.getAttribute('content') ?? '';

        const eyeIcon = document.querySelector('#eye-icon');
        const eyeOffIcon = document.querySelector('#eye-off-icon');

        passwordToggle?.addEventListener('click', () => {
            if (!passwordInput) return;

            const isPassword = passwordInput.type === 'password';
            passwordInput.type = isPassword ? 'text' : 'password';

            eyeIcon?.classList.toggle('hidden', isPassword);
            eyeOffIcon?.classList.toggle('hidden', !isPassword);

            passwordToggle.setAttribute(
                'aria-label',
                isPassword ? 'Скрыть пароль' : 'Показать пароль'
            );
        });

        form?.addEventListener('submit', async (event) => {
            event.preventDefault();

            errorDiv?.classList.add('hidden');

            if (submitBtn) {
                submitBtn.textContent = 'Проверка...';
                submitBtn.disabled = true;
            }

            const formData = new FormData(form);

            const response = await fetch(`${backendApiUrl}/auth/login`, {
                method: 'POST',
                credentials: 'include',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    ...(csrfToken ? { 'X-CSRF-Token': csrfToken } : {}),
                },
                body: JSON.stringify({
                    username: formData.get('username'),
                    password: formData.get('password'),
                }),
            });

            if (!response.ok) {
                const payload = await response.json().catch(() => ({}));

                if (errorDiv) {
                    errorDiv.textContent = payload.detail ?? 'Не удалось войти';
                    errorDiv.classList.remove('hidden');
                }

                if (submitBtn) {
                    submitBtn.textContent = 'Вход';
                    submitBtn.disabled = false;
                }

                return;
            }

            const payload = await response.json().catch(() => ({}));
            const redirectUrl = payload?.user?.mustChangePassword ? '/profile?forcePasswordChange=1' : '/dashboard';

            window.location.href = redirectUrl;
        });
    </script>

    <style>
        .auth-page {
            position: relative;
            min-height: calc(100vh - 120px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 48px 16px;
        }

        .auth-card {
            width: 100%;
            max-width: 444px;
            padding: 30px 34px;
            border-radius: 12px;
            background: #ffffff;
            box-shadow: 0 24px 70px rgba(15, 23, 42, 0.08);
        }

        .auth-head {
            margin-bottom: 60px;
        }

        .auth-head h1 {
            margin: 0;
            font-size: 24px;
            line-height: 1.1;
            font-weight: 900;
            color: #111827;
        }

        .auth-head p {
            margin: 4px 0 0;
            font-size: 17px;
            line-height: 1.3;
            color: #6b7280;
        }

        .auth-form {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .auth-form h2 {
            margin: 0 0 18px;
            font-size: 22px;
            line-height: 1.1;
            font-weight: 900;
            color: #111827;
        }

        .auth-desc {
            max-width: 340px;
            margin: 0;
            font-size: 17px;
            line-height: 1.25;
            color: #6b7280;
        }

        .auth-field {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .auth-field label {
            font-size: 16px;
            font-weight: 800;
            color: #111827;
        }

        .auth-field input,
        .password-wrap input {
            width: 100%;
            height: 46px;
            border: 0;
            border-radius: 8px;
            background: #f3f3f3;
            padding: 0 14px;
            font-size: 17px;
            color: #111827;
            outline: none;
        }

        .auth-field input:focus,
        .password-wrap input:focus {
            background: #e8f3ff;
        }

        .password-wrap {
            position: relative;
        }

        .password-wrap input {
            padding-right: 54px;
        }

        .password-wrap button {
            position: absolute;
            top: 50%;
            right: 8px;
            width: 36px;
            height: 36px;
            transform: translateY(-50%);
            border: 0;
            border-radius: 8px;
            background: #eeeeee;
            color: #111827;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .password-wrap button svg {
            width: 22px;
            height: 22px;
        }

        .remember-row {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-top: 4px;
            font-size: 20px;
            color: #111827;
            cursor: pointer;
        }

        .remember-row input {
            width: 21px;
            height: 21px;
            accent-color: #5b7cfa;
        }

        .auth-submit {
            height: 50px;
            margin-top: 30px;
            border: 0;
            border-radius: 10px;
            background: #9baaf0;
            color: #ffffff;
            font-size: 16px;
            font-weight: 900;
            cursor: pointer;
            transition: transform 0.18s ease, background-color 0.18s ease, box-shadow 0.18s ease;
        }

        .auth-submit:hover {
            background: #8698ed;
            transform: translateY(-1px);
            box-shadow: 0 14px 28px rgba(91, 124, 250, 0.18);
        }

        .auth-submit:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .auth-error {
            border-radius: 8px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            padding: 12px 14px;
            font-size: 14px;
            font-weight: 600;
            color: #dc2626;
        }

        .hidden {
            display: none;
        }

        .back-link {
            color: var(--text-main);
            font-size: 14px;
            font-weight: 800;
            text-decoration: none;
        }

        .back-link:hover {
            opacity: 0.7;
        }

        html.dark .auth-card {
            background: #151b23;
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
        }

        html.dark .auth-head h1,
        html.dark .auth-form h2,
        html.dark .auth-field label,
        html.dark .remember-row {
            color: #ffffff;
        }

        html.dark .auth-head p,
        html.dark .auth-desc {
            color: rgba(255, 255, 255, 0.58);
        }

        html.dark .auth-field input,
        html.dark .password-wrap input {
            background: rgba(255, 255, 255, 0.08);
            color: #ffffff;
        }

        html.dark .auth-field input:focus,
        html.dark .password-wrap input:focus {
            background: rgba(255, 255, 255, 0.13);
        }

        html.dark .password-wrap button {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
        }

        @media (max-width: 480px) {
            .auth-card {
                padding: 26px 22px;
            }

            .auth-head {
                margin-bottom: 44px;
            }
        }
        .back-schedule-link {
            width: 50px;
            height: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: transform 0.2s ease, opacity 0.2s ease;
        }

        .back-schedule-link:hover {
            transform: translateY(-2px) scale(1.05);
            opacity: 0.78;
        }

        .back-schedule-icon {
            width: 28px;
            height: 28px;
            object-fit: contain;
            filter: invert(0);
        }

        html.dark .back-schedule-icon {
            filter: invert(1);
        }
    </style>
</Layout>